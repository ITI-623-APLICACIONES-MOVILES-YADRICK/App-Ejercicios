<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Configuración de características -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Permisos requeridos -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppGym"
        tools:targetApi="31">

        <!-- Declaración del FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.appgym.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Actividades de la aplicación -->
        <activity
            android:name=".Pantalla6"
            android:exported="false" />
        <activity
            android:name=".Pantalla5"
            android:exported="false" />
        <activity
            android:name=".Pantalla4"
            android:exported="false" />
        <activity
            android:name=".Pantalla3"
            android:exported="false" />
        <activity
            android:name=".PersonalizarRutina"
            android:exported="false" />
        <activity
            android:name=".Pantalla2"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
